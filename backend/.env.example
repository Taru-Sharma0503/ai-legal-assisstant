PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ailegal?schema=public
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

# AI Configuration
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=citizen_service_chunks

SIMILARITY_THRESHOLD=0.80
AI_REQUEST_TIMEOUT_MS=15000

BASE_URL=http://localhost:5000

MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

RATE_LIMIT_AI_MAX=10
RATE_LIMIT_AI_WINDOW_SECONDS=60