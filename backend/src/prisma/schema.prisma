datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CITIZEN
  AGENT
  ADMIN
}

enum ApplicationMethod {
  ONLINE
  OFFLINE
  BOTH
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum EscalationStatus {
  PENDING
  IN_REVIEW
  RESPONDED
  RESOLVED
  CLOSED
}

enum SenderRole {
  CITIZEN
  AGENT
  ADMIN
}

enum AiMessageSender {
  USER
  AI
}

model User {
  id                String              @id @default(uuid())
  name              String
  email             String              @unique
  password          String
  role              UserRole            @default(CITIZEN)
  preferredLanguage String              @default("en")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  conversations     AiConversation[]
  applications      Application[]
  escalations       Escalation[]
  messages          EscalationMessage[]

  @@map("users")
}

model AiConversation {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    String         @default("hi")
  title       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    AiMessage[]
  escalations Escalation[]

  @@map("ai_conversations")
}

model AiMessage {
  id                   String          @id @default(uuid())
  conversationId       String
  conversation         AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender               AiMessageSender
  content              String          @db.Text
  confidence           Float?
  needsHuman           Boolean         @default(false)
  sources              Json?
  suggestedServiceId   String?
  suggestedServiceName String?
  createdAt            DateTime        @default(now())

  @@map("ai_messages")
}

model Service {
  id                  String             @id @default(uuid())
  name                String
  department          String
  description         String             @db.Text
  eligibility         String?            @db.Text
  applicationMethod   ApplicationMethod  @default(BOTH)
  governmentPortalUrl String?
  region              String
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  documents           ServiceDocument[]
  applications        Application[]
  offices             OfficeService[]
  knowledgeSources    KnowledgeBase[]

  @@map("services")
}

model ServiceDocument {
  id          String   @id @default(uuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  mandatory   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("service_documents")
}

model Office {
  id           String          @id @default(uuid())
  name         String
  address      String          @db.Text
  city         String
  state        String
  pincode      String
  latitude     Float
  longitude    Float
  phone        String?
  workingHours String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  services     OfficeService[]

  @@map("offices")
}

model OfficeService {
  id        String   @id @default(uuid())
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([officeId, serviceId])
  @@map("office_services")
}

model Application {
  id              String                @id @default(uuid())
  referenceNumber String                @unique
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  status          ApplicationStatus     @default(DRAFT)
  applicationDate DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  documents       ApplicationDocument[]

  @@map("applications")
}

model ApplicationDocument {
  id            String         @id @default(uuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  fileUrl       String?
  status        DocumentStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("application_documents")
}

model Escalation {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AiConversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  subject        String
  description    String              @db.Text
  status         EscalationStatus    @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages       EscalationMessage[]

  @@map("escalations")
}

model EscalationMessage {
  id           String     @id @default(uuid())
  escalationId String
  escalation   Escalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole   SenderRole
  message      String     @db.Text
  createdAt    DateTime   @default(now())

  @@map("escalation_messages")
}

model KnowledgeBase {
  id         String   @id @default(uuid())
  title      String
  department String
  sourceUrl  String?
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  content    String   @db.Text
  language   String   @default("hi")
  verified   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("knowledge_bases")
}
